<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Food HUB</title>
    <link rel="stylesheet" href="~/Content/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
</head>
<body>

    <!-- Top Bar -->
    <div class="top-bar">
        <div class="container">
            <span><i class="fas fa-phone"></i> +1 (555) 123-4567</span>
            <span><i class="fas fa-envelope"></i> hello@foodhub.com</span>
            <span><i class="fas fa-clock"></i> Mon–Sun: 10:00 AM – 10:00 PM</span>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <a class="brand" href="@Url.Action("Index", "Home")">
                <i class="fas fa-utensils"></i> Food<span>HUB</span>
            </a>
            <input type="checkbox" id="nav-toggle" class="nav-toggle" />
            <label for="nav-toggle" class="nav-toggle-label">
                <span></span><span></span><span></span>
            </label>
            <ul class="nav-links">
                <li>@Html.ActionLink("Home", "Index", "Home", null, new { @class = Request.RequestContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "" })</li>
                <li>@Html.ActionLink("Menu", "Index", "Menu", null, new { @class = Request.RequestContext.RouteData.Values["controller"].ToString() == "Menu" ? "active" : "" })</li>
                <li>@Html.ActionLink("Reservations", "Index", "Reservation", null, new { @class = Request.RequestContext.RouteData.Values["controller"].ToString() == "Reservation" ? "active" : "" })</li>
                <li>@Html.ActionLink("About", "Index", "About", null, new { @class = Request.RequestContext.RouteData.Values["controller"].ToString() == "About" ? "active" : "" })</li>
                <li>@Html.ActionLink("Contact", "Index", "Contact", null, new { @class = Request.RequestContext.RouteData.Values["controller"].ToString() == "Contact" ? "active" : "" })</li>
            </ul>
        </div>
    </nav>

    <!-- Page Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-brand">
                <h3><i class="fas fa-utensils"></i> Food<span>HUB</span></h3>
                <p>Bringing people together through the joy of great food. Fresh ingredients, bold flavours, unforgettable experiences.</p>
                <div class="social-links">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                </div>
            </div>
            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <li>@Html.ActionLink("Home", "Index", "Home")</li>
                    <li>@Html.ActionLink("Our Menu", "Index", "Menu")</li>
                    <li>@Html.ActionLink("Make a Reservation", "Index", "Reservation")</li>
                    <li>@Html.ActionLink("About Us", "Index", "About")</li>
                    <li>@Html.ActionLink("Contact", "Index", "Contact")</li>
                </ul>
            </div>
            <div class="footer-hours">
                <h4>Opening Hours</h4>
                <ul>
                    <li><span>Monday – Friday</span><span>10:00 AM – 10:00 PM</span></li>
                    <li><span>Saturday</span><span>9:00 AM – 11:00 PM</span></li>
                    <li><span>Sunday</span><span>9:00 AM – 9:00 PM</span></li>
                </ul>
            </div>
            <div class="footer-contact">
                <h4>Find Us</h4>
                <p><i class="fas fa-map-marker-alt"></i> 123 Flavour Street, Food City, FC 10001</p>
                <p><i class="fas fa-phone"></i> +1 (555) 123-4567</p>
                <p><i class="fas fa-envelope"></i> hello@foodhub.com</p>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>&copy; @DateTime.Now.Year Food HUB. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
