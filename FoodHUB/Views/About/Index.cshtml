@{
    ViewBag.Title = "About Us";
}

<!-- Page Banner -->
<section class="page-banner">
    <div class="page-banner-overlay"></div>
    <div class="container">
        <h1>About Us</h1>
        <p>A passion project born from love of food, family, and community.</p>
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li>@Html.ActionLink("Home", "Index", "Home")</li>
                <li class="separator"><i class="fas fa-chevron-right"></i></li>
                <li class="active">About</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Our Story -->
<section class="section about-story">
    <div class="container about-split">
        <div class="about-image-block">
            <div class="about-img-main"></div>
            <div class="about-img-accent">
                <div class="about-badge">
                    <span class="badge-number">12</span>
                    <span class="badge-text">Years of Excellence</span>
                </div>
            </div>
        </div>
        <div class="about-text">
            <p class="section-label">Our Story</p>
            <h2>From a Small Kitchen to a Culinary Destination</h2>
            <p>Food HUB was founded in 2012 by Chef Marco Delgado and his partner Elena, who shared a simple dream: to create a place where anyone could sit down to an extraordinary meal made with honest, locally sourced ingredients.</p>
            <p>What started as a 30-seat bistro on Flavour Street has grown into one of the city's most beloved dining destinations — but we have never lost sight of what matters: great food, warm hospitality, and a welcoming table for everyone.</p>
            <p>Every dish we serve is a reflection of our commitment to quality, creativity, and the belief that food has the power to bring people together.</p>
            <div class="about-values">
                <div class="value-item">
                    <i class="fas fa-check-circle"></i>
                    <span>100% locally sourced produce</span>
                </div>
                <div class="value-item">
                    <i class="fas fa-check-circle"></i>
                    <span>No artificial flavours or preservatives</span>
                </div>
                <div class="value-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Sustainable kitchen practices</span>
                </div>
                <div class="value-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Community-first philosophy</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="mission-section">
    <div class="container mission-grid">
        <div class="mission-card">
            <i class="fas fa-bullseye"></i>
            <h3>Our Mission</h3>
            <p>To deliver an exceptional dining experience through creative cuisine, impeccable service, and a genuine passion for food — every single visit.</p>
        </div>
        <div class="mission-card">
            <i class="fas fa-eye"></i>
            <h3>Our Vision</h3>
            <p>To be the dining destination that defines the city's food culture — a place where memories are made and every guest feels at home.</p>
        </div>
        <div class="mission-card">
            <i class="fas fa-hands-holding-heart"></i>
            <h3>Our Values</h3>
            <p>Quality, integrity, community, and sustainability guide every decision we make — from the suppliers we choose to the plates we serve.</p>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="section team-section">
    <div class="container">
        <div class="section-header">
            <p class="section-label">The People Behind the Food</p>
            <h2>Meet Our Team</h2>
            <p class="section-sub">Our chefs bring decades of combined experience from kitchens around the world.</p>
        </div>
        <div class="team-grid">
            <div class="team-card">
                <div class="team-avatar avatar-1"></div>
                <div class="team-info">
                    <h3>Chef Marco Delgado</h3>
                    <span class="team-role">Head Chef &amp; Co-Founder</span>
                    <p>Trained in Paris and Barcelona, Marco brings French technique and Mediterranean soul to every dish.</p>
                </div>
            </div>
            <div class="team-card">
                <div class="team-avatar avatar-2"></div>
                <div class="team-info">
                    <h3>Elena Delgado</h3>
                    <span class="team-role">Operations Director &amp; Co-Founder</span>
                    <p>Elena manages the heart of the restaurant, ensuring every guest experiences flawless service and care.</p>
                </div>
            </div>
            <div class="team-card">
                <div class="team-avatar avatar-3"></div>
                <div class="team-info">
                    <h3>Chef Yuki Tanaka</h3>
                    <span class="team-role">Pastry Chef</span>
                    <p>Yuki's desserts are works of art — her molten fondant has been called "the city's best" three years in a row.</p>
                </div>
            </div>
            <div class="team-card">
                <div class="team-avatar avatar-4"></div>
                <div class="team-info">
                    <h3>Chef Adeola Williams</h3>
                    <span class="team-role">Sous Chef</span>
                    <p>Adeola brings bold West African-inspired flavours that give our grill section its unmistakable character.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Awards -->
<section class="awards-section">
    <div class="container">
        <div class="section-header">
            <p class="section-label">Recognition</p>
            <h2>Awards &amp; Accolades</h2>
        </div>
        <div class="awards-grid">
            <div class="award-item">
                <i class="fas fa-trophy"></i>
                <div>
                    <strong>Best Restaurant — City Food Awards</strong>
                    <span>2023, 2022, 2021</span>
                </div>
            </div>
            <div class="award-item">
                <i class="fas fa-star"></i>
                <div>
                    <strong>Michelin Recommended</strong>
                    <span>2021 – Present</span>
                </div>
            </div>
            <div class="award-item">
                <i class="fas fa-medal"></i>
                <div>
                    <strong>Best Fine Dining Experience</strong>
                    <span>Regional Hospitality Awards 2022</span>
                </div>
            </div>
            <div class="award-item">
                <i class="fas fa-seedling"></i>
                <div>
                    <strong>Green Kitchen Certification</strong>
                    <span>Sustainable Dining Initiative 2020</span>
                </div>
            </div>
        </div>
    </div>
</section>
