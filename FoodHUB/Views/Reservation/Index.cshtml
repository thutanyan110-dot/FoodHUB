@model FoodHUB.Models.Reservation
@{
    ViewBag.Title = "Make a Reservation";
}

<!-- Page Banner -->
<section class="page-banner">
    <div class="page-banner-overlay"></div>
    <div class="container">
        <h1>Reserve a Table</h1>
        <p>Book your dining experience at Food HUB — we look forward to welcoming you.</p>
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li>@Html.ActionLink("Home", "Index", "Home")</li>
                <li class="separator"><i class="fas fa-chevron-right"></i></li>
                <li class="active">Reservations</li>
            </ol>
        </nav>
    </div>
</section>

<section class="section reservation-section">
    <div class="container reservation-layout">

        <!-- Info Side -->
        <div class="reservation-info">
            <h2>Dining Information</h2>
            <p>We accept reservations for groups of 1–20 guests. For larger private events, please contact us directly.</p>

            <div class="res-info-block">
                <h4><i class="fas fa-clock"></i> Opening Hours</h4>
                <table class="hours-table">
                    <tr><td>Monday – Friday</td><td>10:00 AM – 10:00 PM</td></tr>
                    <tr><td>Saturday</td><td>9:00 AM – 11:00 PM</td></tr>
                    <tr><td>Sunday</td><td>9:00 AM – 9:00 PM</td></tr>
                </table>
            </div>

            <div class="res-info-block">
                <h4><i class="fas fa-circle-info"></i> Good to Know</h4>
                <ul class="res-tips">
                    <li><i class="fas fa-check"></i> Reservations held for 15 minutes</li>
                    <li><i class="fas fa-check"></i> Cancellations accepted up to 2 hours before</li>
                    <li><i class="fas fa-check"></i> Special dietary needs? Let us know in notes</li>
                    <li><i class="fas fa-check"></i> Private dining room available for 10+ guests</li>
                </ul>
            </div>

            <div class="res-info-block">
                <h4><i class="fas fa-phone"></i> Prefer to Call?</h4>
                <p>Reach us at <a href="tel:+15551234567"><strong>+1 (555) 123-4567</strong></a><br />
                   or email <a href="mailto:reservations@foodhub.com">reservations@foodhub.com</a></p>
            </div>
        </div>

        <!-- Reservation Form -->
        <div class="reservation-form-wrap">
            <h2>Book Your Table</h2>

            @using (Html.BeginForm("Index", "Reservation", FormMethod.Post, new { @class = "reservation-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FirstName)
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "First name" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "field-error" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.LastName)
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Last name" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "field-error" })
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "your@email.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Phone)
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "+1 (555) 000-0000" })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "field-error" })
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Date)
                        @Html.TextBoxFor(m => m.Date, new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.Date, "", new { @class = "field-error" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Time)
                        @Html.DropDownListFor(m => m.Time,
                            new SelectList(new[] {
                                "10:00 AM","11:00 AM","12:00 PM","1:00 PM","2:00 PM",
                                "3:00 PM","4:00 PM","5:00 PM","6:00 PM","7:00 PM",
                                "8:00 PM","9:00 PM"
                            }),
                            "-- Select a time --",
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Time, "", new { @class = "field-error" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Guests)
                    @Html.DropDownListFor(m => m.Guests,
                        new SelectList(Enumerable.Range(1, 20).Select(i => new { Value = i, Text = i + (i == 1 ? " Guest" : " Guests") }), "Value", "Text"),
                        "-- Number of guests --",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Guests, "", new { @class = "field-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.SpecialRequests)
                    @Html.TextAreaFor(m => m.SpecialRequests, 3, 0, new { @class = "form-control", placeholder = "Allergies, special occasions, seating preferences..." })
                </div>

                <button type="submit" class="btn btn-primary btn-full">
                    <i class="fas fa-calendar-check"></i> Confirm Reservation
                </button>
            }
        </div>
    </div>
</section>

@section scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Set min date to today
    $(function () {
        var today = new Date().toISOString().split('T')[0];
        $('input[type="date"]').attr('min', today);
    });
</script>
}
