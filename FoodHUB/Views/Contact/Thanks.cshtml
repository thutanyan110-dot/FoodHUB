@{
    ViewBag.Title = "Message Sent";
}

<section class="section thanks-section">
    <div class="container thanks-container">
        <div class="thanks-icon">
            <i class="fas fa-circle-check"></i>
        </div>
        <h1>Thank You!</h1>
        <p>Your message has been received. A member of our team will get back to you within 24 hours.</p>
        <div class="thanks-actions">
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Back to Home</a>
            <a href="@Url.Action("Index", "Reservation")" class="btn btn-outline">Make a Reservation</a>
        </div>
    </div>
</section>
