@model FoodHUB.Models.ContactMessage
@{
    ViewBag.Title = "Contact Us";
}

<!-- Page Banner -->
<section class="page-banner">
    <div class="page-banner-overlay"></div>
    <div class="container">
        <h1>Contact Us</h1>
        <p>We would love to hear from you. Get in touch and we will respond within 24 hours.</p>
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li>@Html.ActionLink("Home", "Index", "Home")</li>
                <li class="separator"><i class="fas fa-chevron-right"></i></li>
                <li class="active">Contact</li>
            </ol>
        </nav>
    </div>
</section>

<section class="section contact-section">
    <div class="container contact-layout">

        <!-- Info Cards -->
        <div class="contact-info">
            <h2>Get In Touch</h2>
            <p>Whether you have a question about our menu, want to arrange a private event, or simply want to share your experience — we are all ears.</p>

            <div class="contact-card">
                <div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div>
                <div>
                    <h4>Our Location</h4>
                    <p>123 Flavour Street<br />Food City, FC 10001</p>
                </div>
            </div>
            <div class="contact-card">
                <div class="contact-icon"><i class="fas fa-phone"></i></div>
                <div>
                    <h4>Phone</h4>
                    <p><a href="tel:+15551234567">+1 (555) 123-4567</a></p>
                </div>
            </div>
            <div class="contact-card">
                <div class="contact-icon"><i class="fas fa-envelope"></i></div>
                <div>
                    <h4>Email</h4>
                    <p><a href="mailto:hello@foodhub.com">hello@foodhub.com</a></p>
                </div>
            </div>
            <div class="contact-card">
                <div class="contact-icon"><i class="fas fa-clock"></i></div>
                <div>
                    <h4>Opening Hours</h4>
                    <p>Mon–Fri: 10:00 AM – 10:00 PM<br />
                       Sat: 9:00 AM – 11:00 PM<br />
                       Sun: 9:00 AM – 9:00 PM</p>
                </div>
            </div>

            <div class="contact-social">
                <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form-wrap">
            <h2>Send Us a Message</h2>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            @using (Html.BeginForm("Index", "Contact", FormMethod.Post, new { @class = "contact-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Name)
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Your full name" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "your@email.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Subject)
                    @Html.TextBoxFor(m => m.Subject, new { @class = "form-control", placeholder = "What is this about?" })
                    @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "field-error" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Message)
                    @Html.TextAreaFor(m => m.Message, 5, 0, new { @class = "form-control", placeholder = "Tell us more..." })
                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "field-error" })
                </div>

                <button type="submit" class="btn btn-primary btn-full">
                    <i class="fas fa-paper-plane"></i> Send Message
                </button>
            }
        </div>
    </div>
</section>

<!-- Map Placeholder -->
<section class="map-section">
    <div class="map-placeholder">
        <i class="fas fa-map-location-dot"></i>
        <h3>123 Flavour Street, Food City</h3>
        <p>Located in the heart of the city — easy parking, public transport nearby.</p>
    </div>
</section>

@section scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
